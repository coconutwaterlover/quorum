# ---------------------------------------------------------------------- venue
# testnet (Somnia Shannon, chain 50312, faucet tUSDC) or mainnet (USDso).
# Testnet is the default and the only one you should point a demo at.
QUORUM_NETWORK=testnet

# The venue to trade. A deployment hosts several side by side and the indexer
# returns all of them together, so leaving this blank quotes markets you did not
# mean. The default is the rolling "closes at or above its opening price" venue,
# which is the actual event-contract product.
# QUORUM_VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

# Overrides. Baked-in defaults are the public indexer and RPC for the network
# above, so you normally need neither.
# QUORUM_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
# QUORUM_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws

# -------------------------------------------------------------------- trading
# Everything works read-only with none of this set: the app discovers markets,
# prices baskets, measures correlations, replays history, and shows the exact
# orders it would send. Only the sending needs a key.
#
# Two switches rather than one, on purpose — a key found in the environment is
# not consent to spend it.
# QUORUM_ALLOW_TRADING=1
# QUORUM_PRIVATE_KEY=0x

# Hard ceiling on the collateral any single request may commit. The buy route
# refuses anything above it. Keep it small: on a hosted demo this key is spending
# for anyone who opens the page.
QUORUM_MAX_STAKE=25
